---
/**
 * /404.astro 根级 404 页面
 *
 * 网站根级别的404错误页面，当用户访问不存在的页面时显示。
 * 遵循纸墨设计系统（Paper & Ink），提供统一的视觉与导航。
 *
 * @page
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { defaultLocale, type Locale } from '@lib/i18n';

// 404页面使用默认语言
const lang: Locale = defaultLocale;

// 404页面文本内容
const t = {
  title: '404 - 页面未找到',
  description: '抱歉，您访问的页面不存在',
  heading: '页面走失在字里行间',
  message: '链接或许已更新或被归档。若要继续探索，请选择以下操作：',
  homeButton: '返回首页',
  contactButton: '联系 Wenjie',
  projectsTitle: '探索发现',
  projectsText: '浏览',
  projectsLink: '关于页',
  projectsEnd: '，了解正在进行的课题、作品与思考',
  contactTitle: '建立联系',
  contactText: '有任何想法或建议？随时点此',
  contactLink: '写邮件',
  contactEnd: '与我交流',
};
---

<BaseLayout title={t.title} description={t.description} lang={lang}>
  <div class='min-h-[70vh] flex items-center justify-center py-16 sm:py-24'>
    <div class='max-w-2xl mx-auto px-6 text-center'>
      {/* 404 错误标识：使用朱砂红单字距修饰 */}
      <p class='font-mono text-xs uppercase tracking-[0.4em] text-vermilion mb-4'>Error 404</p>

      {/* 主标题 */}
      <h1 class='display-font text-4xl sm:text-5xl font-semibold text-ink mb-6'>{t.heading}</h1>

      {/* 描述信息 */}
      <p class='text-inksoft text-base sm:text-lg leading-relaxed mb-10'>{t.message}</p>

      {/* 操作按钮区域 */}
      <div class='flex flex-col sm:flex-row sm:justify-center gap-4 mb-16'>
        <a
          href={`/${lang}/`}
          data-astro-prefetch='hover'
          class='inline-flex items-center justify-center border border-ink text-ink hover:bg-ink hover:text-paper px-8 py-3 text-sm tracking-[0.15em] transition-colors'
        >
          {t.homeButton}
        </a>

        <a
          href={`/${lang}/contact/`}
          data-astro-prefetch='hover'
          class='inline-flex items-center justify-center border border-hairline text-ink hover:border-ink px-8 py-3 text-sm tracking-[0.15em] transition-colors'
        >
          {t.contactButton}
        </a>
      </div>

      {/* 建议导航卡片 */}
      <div class='grid sm:grid-cols-2 gap-6 text-left border-t border-hairline pt-10'>
        <article class='border-t border-hairline pt-4 sm:border-t-0 sm:pt-0'>
          <h2 class='display-font text-lg font-semibold text-ink mb-2'>{t.projectsTitle}</h2>
          <p class='text-inksoft text-sm leading-relaxed'>
            {t.projectsText}
            <a
              href={`/${lang}/about/`}
              data-astro-prefetch='hover'
              class='link-underline text-vermilion hover:text-ink font-medium mx-1'
            >
              {t.projectsLink}
            </a>
            {t.projectsEnd}
          </p>
        </article>

        <article class='border-t border-hairline pt-4 sm:border-t-0 sm:pt-0'>
          <h2 class='display-font text-lg font-semibold text-ink mb-2'>{t.contactTitle}</h2>
          <p class='text-inksoft text-sm leading-relaxed'>
            {t.contactText}
            <a
              href={`/${lang}/contact/`}
              data-astro-prefetch='hover'
              class='link-underline text-vermilion hover:text-ink font-medium mx-1'
            >
              {t.contactLink}
            </a>
            {t.contactEnd}
          </p>
        </article>
      </div>
    </div>
  </div>
</BaseLayout>

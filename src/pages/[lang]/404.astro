---
/**
 * /[lang]/404.astro
 * 多语言 404 错误页面
 *
 * 遵循纸墨设计系统（Paper & Ink）
 *
 * @page
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { getI18n, locales, type Locale } from '@lib/i18n';

/**
 * 生成静态路径
 * 为每个支持的语言生成静态路径
 */
export function getStaticPaths() {
  return locales.map(lang => ({
    params: { lang },
  }));
}

// 获取当前语言参数
const { lang } = Astro.params as { lang: Locale };

// 从内容集合获取翻译数据
const translations = await getI18n(lang);
const { site } = translations;

/**
 * 多语言页面内容配置
 */
const content = {
  zh_CN: {
    title: '404 - 页面未找到',
    heading: '页面走失在字里行间',
    description: '抱歉，您访问的页面不存在或已被归档。',
    backHome: '返回首页',
  },
  en_US: {
    title: '404 - Page Not Found',
    heading: 'Page Not Found',
    description: 'Sorry, the page you are looking for does not exist or has been moved.',
    backHome: 'Back to Home',
  },
};

const pageContent = content[lang] || content.en_US;
---

<BaseLayout
  title={`${pageContent.title} | ${site.title}`}
  description={pageContent.description}
  lang={lang}
>
  <div class='min-h-[65vh] flex flex-col items-center justify-center text-center py-16 sm:py-24'>
    {/* 404 错误标识 */}
    <p class='font-mono text-xs uppercase tracking-[0.4em] text-vermilion mb-4'>Error 404</p>

    {/* 页面标题 */}
    <h1 class='display-font text-4xl sm:text-5xl font-semibold text-ink mb-6'>
      {pageContent.heading}
    </h1>

    {/* 页面描述 */}
    <p class='text-inksoft text-base sm:text-lg max-w-md mx-auto leading-relaxed mb-10'>
      {pageContent.description}
    </p>

    {/* 返回首页链接 */}
    <a
      href={`/${lang}/`}
      data-astro-prefetch='hover'
      class='inline-flex items-center justify-center border border-ink text-ink hover:bg-ink hover:text-paper px-8 py-3 text-sm tracking-[0.15em] transition-colors'
    >
      <span class='mr-2' aria-hidden='true'>
        &larr;
      </span>
      {pageContent.backHome}
    </a>
  </div>
</BaseLayout>

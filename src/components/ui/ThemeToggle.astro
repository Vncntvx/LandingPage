---
/**
 * ThemeToggle.astro
 * 原生主题切换组件（零 React 依赖）
 *
 * 通过 CSS 类 (.dark) 实时响应主题状态，
 * 无首屏图标空白闪烁、无水合开销。
 */
---

<button
  type='button'
  id='theme-toggle-btn'
  class='p-2 text-inksoft hover:text-vermilion transition-colors focus:outline-none'
  aria-label='切换颜色主题'
  title='切换颜色主题'
>
  <!-- 太阳图标：深色模式时显示，点击切换到浅色模式 -->
  <svg
    xmlns='http://www.w3.org/2000/svg'
    class='h-5 w-5 hidden dark:block'
    fill='none'
    viewBox='0 0 24 24'
    stroke='currentColor'
    aria-hidden='true'
  >
    <path
      stroke-linecap='round'
      stroke-linejoin='round'
      stroke-width='2'
      d='M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z'
    ></path>
  </svg>
  <!-- 月亮图标：浅色模式时显示，点击切换到深色模式 -->
  <svg
    xmlns='http://www.w3.org/2000/svg'
    class='h-5 w-5 block dark:hidden'
    fill='none'
    viewBox='0 0 24 24'
    stroke='currentColor'
    aria-hidden='true'
  >
    <path
      stroke-linecap='round'
      stroke-linejoin='round'
      stroke-width='2'
      d='M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z'
    ></path>
  </svg>
</button>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle-btn');
    if (btn && !btn.dataset.bound) {
      btn.dataset.bound = 'true';
      btn.addEventListener('click', function () {
        var isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch (e) {}
      });
    }
  })();
</script>

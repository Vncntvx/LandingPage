{
    "name": "starter-theme",
    "version": "2.0.0",
    "description": "A modern, minimalist personal landing page theme built with Astro 7, React 19 and Tailwind CSS 4",
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "dev:node": "NODE_OPTIONS='' astro dev",
        "build": "astro build",
        "build:node": "NODE_OPTIONS='' astro build",
        "preview": "astro preview",
        "astro": "astro",
        "fetch:rss": "bun run scripts/fetch-rss.bun.js",
        "prebuild": "bun run scripts/fetch-rss.bun.js || true",
        "format": "prettier --write '**/*.{js,jsx,ts,tsx,json,css,html,astro}'",
        "format:check": "prettier --check '**/*.{js,jsx,ts,tsx,json,css,html,astro}'",
        "type-check": "tsc --noEmit",
        "lint": "astro check",
        "clean": "rm -rf dist node_modules .astro",
        "reinstall": "bun run clean && bun install"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Vncntvx/LandingPage.git"
    },
    "keywords": [
        "astro",
        "astro-theme",
        "landing-page",
        "personal-website",
        "portfolio",
        "tailwindcss",
        "react",
        "i18n",
        "dark-mode",
        "static-site"
    ],
    "author": "Wenjie Xu <wenjie.xu.cn@outlook.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Vncntvx/LandingPage/issues"
    },
    "homepage": "https://github.com/Vncntvx/LandingPage#readme",
    "devDependencies": {
        "@astrojs/react": "^7.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@astrojs/mdx": "^8.0.3",
        "@astrojs/sitemap": "^3.7.4",
        "@emailjs/browser": "^5.0.3",
        "@fontsource/eb-garamond": "^5.3.0",
        "@fontsource/noto-serif-sc": "^5.3.1",
        "@iconify-json/mdi": "^1.2.3",
        "astro": "^7.3.8",
        "astro-icon": "^1.2.0",
        "astro-robots-txt": "^1.0.0",
        "astro-seo": "^1.2.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    }
}
